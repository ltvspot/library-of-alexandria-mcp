{
  "openapi": "3.1.0",
  "info": {
    "title": "Library of Alexandria API",
    "version": "2026-10-25",
    "summary": "Look up the library's catalogue, free shelf and print editions.",
    "description": "Library of Alexandria Press publishes the world's classic books in today's language, in 25 languages. This API gives every tool of the library's MCP server as one plain HTTP operation: POST /v1/<tool> with a JSON body of the tool's arguments. All operations only read: none signs anyone in, takes a payment or changes anything. Every title comes back with the address of its page on libraryofalexandria.com, where a person reads, listens, prints or starts. No key is needed. Errors are problem+json (RFC 9457).",
    "termsOfService": "https://libraryofalexandria.com/policies/terms-of-service",
    "contact": {
      "name": "Library of Alexandria Press",
      "url": "https://libraryofalexandria.com"
    }
  },
  "servers": [
    {
      "url": "https://api.libraryofalexandria.com",
      "description": "This service"
    }
  ],
  "security": [],
  "externalDocs": {
    "description": "Developer documentation",
    "url": "https://libraryofalexandria.com/pages/developers"
  },
  "tags": [
    {
      "name": "catalogue",
      "description": "Find a book and read its facts."
    },
    {
      "name": "free-shelf",
      "description": "The free shelf and its chapters."
    },
    {
      "name": "print",
      "description": "Print editions of a book."
    },
    {
      "name": "publisher",
      "description": "About the publisher."
    },
    {
      "name": "other",
      "description": "Other operations."
    }
  ],
  "paths": {
    "/v1/search_books": {
      "post": {
        "operationId": "search_books",
        "summary": "Search books",
        "description": "Search the catalogue of Library of Alexandria Press by words from a title or an author's name, or by a topic word, in any language of the catalogue (Chinese in simplified and traditional characters). Returns up to 8 titles with id, title, subtitle, author, language, whether print editions are available, and the address of the title page on libraryofalexandria.com. Pass the asker's language so titles and authors come back in it.",
        "tags": [
          "catalogue"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "Words from a title or an author's name, or a topic word, in any language. Example: 'Moby Dick', 'Dostoevsky', 'war strategy'.",
                    "maxLength": 200
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "en",
                      "es",
                      "de",
                      "nl",
                      "fr",
                      "it",
                      "pt-BR",
                      "ru",
                      "zh-CN",
                      "zh-TW",
                      "ja",
                      "ko",
                      "pl",
                      "ar",
                      "hi",
                      "id"
                    ],
                    "description": "Language of the person asking, as a code: en English, es Spanish, de German, nl Dutch, fr French, it Italian, pt-BR Portuguese, ru Russian, zh-CN Chinese, zh-TW Chinese in traditional characters, ja Japanese, ko Korean, pl Polish, ar Arabic, hi Hindi, id Indonesian. Titles, subtitles, authors and page addresses come back in this language. Default: the language of the query, else English."
                  },
                  "limit": {
                    "type": "integer",
                    "description": "Number of titles to return, 1 to 8. Default 8.",
                    "minimum": 1,
                    "maximum": 8
                  }
                },
                "required": [
                  "query"
                ],
                "additionalProperties": false
              },
              "example": {
                "query": "Moby Dick"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tool's answer in the envelope.",
            "headers": {
              "LOA-Version": {
                "description": "The version date of this API.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchBooksResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
